<?xml version="1.0" encoding="utf-8"?>
<!-- Everything is HTTPS, except a home server over Tailscale without `tailscale serve`: its
     traffic is already end-to-end encrypted by WireGuard, but the computer has no certificate.
     One that has HTTPS is moved to it (HomeServer.preferHttps), so this is only for those. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">ts.net</domain>
    </domain-config>
</network-security-config>
