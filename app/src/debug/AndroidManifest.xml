<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- Debug builds only. DUMP is held by adb's shell, not by apps. -->
        <receiver
            android:name=".debug.DebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="net.boswell.phone.debug.MODE" />
                <action android:name="net.boswell.phone.debug.SYNC" />
                <action android:name="net.boswell.phone.debug.ASK" />
                <action android:name="net.boswell.phone.debug.TRIGGER" />
                <action android:name="net.boswell.phone.debug.TRIGGERS_ON" />
                <action android:name="net.boswell.phone.debug.DELETE" />
                <action android:name="net.boswell.phone.debug.EDIT" />
                <action android:name="net.boswell.phone.debug.CALENDAR" />
                <action android:name="net.boswell.phone.debug.CAL_REFRESH" />
                <action android:name="net.boswell.phone.debug.NAME" />
                <action android:name="net.boswell.phone.debug.FEED" />
                <action android:name="net.boswell.phone.debug.BATTERY" />
                <action android:name="net.boswell.phone.debug.RECOVER" />
                <action android:name="net.boswell.phone.debug.LIFE_DELETE" />
                <action android:name="net.boswell.phone.debug.BUDGET" />
                <action android:name="net.boswell.phone.debug.LED" />
                <action android:name="net.boswell.phone.debug.DEMO" />
                <action android:name="net.boswell.phone.debug.MIGRATE" />
                <action android:name="net.boswell.phone.debug.BENCH_ID" />
                <action android:name="net.boswell.phone.debug.HOME_PAIR" />
                <action android:name="net.boswell.phone.debug.PROCESS" />
                <action android:name="net.boswell.phone.debug.TEXTING" />
                <action android:name="net.boswell.phone.debug.RECHECK" />
                <action android:name="net.boswell.phone.debug.CLOUD_REDO" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
